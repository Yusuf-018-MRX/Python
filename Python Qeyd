# OOP (Object Oriented Programming) - obyekt yönümlü proqramlaşdırma
# Procedural Programming - prosedur yönümlü proqramlaşdırma
# OOP-də hər şey obyektlər üzərində qurulur
# OOP-nin əsas prinsipləri:
# 1. Encapsulation (Kapsülləmə) - məlumatların və funksiyaların bir obyekt daxilində təhlükəsiz saxlanılması və gizlənməsi
# 2. Abstraction (Abstraksiya) - mürəkkəb sistemlərin sadələşdirilməsi, yalnız vacib məlumatların göstərilməsi
# 3. Inheritance (Varislik) - yeni siniflərin mövcud siniflərdən irsən alınması
# 4. Polymorphism (Polimorfizm) - eyni adın fərqli funksiyaları yerinə yetirməsi
# Sinif (Class) - obyektlərin şablonudur
# Obyekt (Object) - sinifin nümunəsidir (instance)
class Car:  # sinifin yaradılması
    def __init__(self, brand, model, year, color):  # konstruktor - obyekt yaradılarkən çağırılır
        self.brand = brand  # atribut - sinifin dəyişəni
        self.model = model
        self.year = year
        self.color = color # self - obyektin özünü göstərir

    def info(self):  # metod - sinifin funksiyası
        print(f"Brand: {self.brand}, Model: {self.model}, Year: {self.year}")

car1 = Car("Toyota", "Camry", 2020, "White")  # obyektin yaradılması
car2 = Car("Honda", "Civic", 2019, "Black")
car1.info()  # Brand: Toyota, Model: Camry, Year: 2020
car2.info()  # Brand: Honda, Model: Civic, Year: 2019
# İrsi (Inheritance) - yeni sinifin mövcud sinifdən irsən alınması
class ElectricCar(Car):  # ElectricCar sinifi Car sinifindən irsən alınır
    def __init__(self, brand, model, year, color, battery_size):  # konstruktor
        super().__init__(brand, model, year, color)  # super() - valideyn sinifin konstruktorunu çağırır
        self.battery_size = battery_size  # yeni atribut

    def info(self):  # metod
        super().info()  # valideyn sinifin info metodunu çağırır
        print(f"Battery Size: {self.battery_size} kWh")

electric_car1 = ElectricCar("Tesla", "Model S", 2021, "Red", 100)  # obyektin yaradılması
electric_car1.info()
# Encapuslation (Kapsülləmə) - məlumatların və funksiyaların bir obyekt daxilində təhlükəsiz saxlanılması və gizlənməsi
class Person:
    def __init__(self, name, age):
        self.__name = name  # private atribut - iki alt xətt ilə başlayır
        self.__age = age

    def get_name(self):  # getter metod - private atributa daxil olmaq üçün istifadə olunur
        return self.__name

    def set_name(self, name):  # setter metod - private atributu dəyişdirmək üçün istifadə olunur
        self.__name = name

    def get_age(self):
        return self.__age

    def set_age(self, age):
        if age >= 0:
            self.__age = age
        else:
            print("Age cannot be negative")

person1 = Person("Alice", 25)
